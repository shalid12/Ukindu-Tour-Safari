# ==============================================================================
# UKINDU TOUR & SAFARI — PERFORMANCE, CACHING & CLEAN URLS (.htaccess)
# ==============================================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.html

# ------------------------------------------------------------------------------
# 1. Clean Extensionless URLs & HTTPS Redirect
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (uncomment if not already handled at cPanel/Cloudflare level)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect /index or /index.html to root /
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # Redirect explicit .html requests to extensionless URLs
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Internally serve .html files for extensionless URLs
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 2. Brotli & Gzip Text Compression (HTML, CSS, JS, XML, SVG, Fonts)
# ------------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# 3. Long-Term Browser Caching (Instant Image & Asset Loading)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: short cache so content updates appear quickly
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"

  # Images: 1 year browser cache
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS, JS & Fonts
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Keep connections alive for faster parallel image loading
  Header set Connection keep-alive

  # Cache-Control headers
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|gif|svg|ico|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>

  # Basic security & performance headers
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Vary "Accept-Encoding"
</IfModule>

# Disable ETags when Cache-Control/Expires handle caching
FileETag None
